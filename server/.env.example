PORT=5000
NODE_ENV=development
DATABASE_URL="file:./dev.db"
# For MongoDB / Docker (Replica Set required for Prisma nested writes/transactions):
# DATABASE_URL="mongodb://mongodb:27017/pathoflow_db?replicaSet=rs0"
# For local MongoDB running as replica set:
# DATABASE_URL="mongodb://localhost:27017/pathoflow_db?replicaSet=rs0"
# Or MongoDB Atlas (Atlas enables replica sets automatically):
# DATABASE_URL="mongodb+srv://<user>:<password>@cluster0.mongodb.net/pathoflow_db?retryWrites=true&w=majority"
REDIS_URL="redis://localhost:6379"
QA_WORKER_INTERVAL_MS=30000
